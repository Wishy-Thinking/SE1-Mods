<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <RespawnShips>
    <Ship> <!-- Planetary -->
      <Id>
        <TypeId>RespawnShipDefinition</TypeId>
        <SubtypeId>RespawnRover</SubtypeId>
      </Id>
      <DisplayName>Planet: Cyclotron C-23</DisplayName>
      <Icon>Textures\GUI\Icons\RespawnShips\C-23-Europa.png</Icon>
      <CooldownSeconds>90</CooldownSeconds>
      <Prefab>Cyclotron C-23</Prefab>

      <UseForSpace>false</UseForSpace>
      <UseForPlanetsWithAtmosphere>true</UseForPlanetsWithAtmosphere>
      <UseForPlanetsWithoutAtmosphere>false</UseForPlanetsWithoutAtmosphere>
      <PlanetDeployAltitude>4</PlanetDeployAltitude>

      <HelpTextLocalizationId>Gravity field drop-off</HelpTextLocalizationId>
    </Ship>
    <Ship> <!-- Space (Anywhere) -->
