<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://storage.googleapis.com/unofficial-keen-schemas/latest/space-vanilla.xsd">
    <Definition xsi:type="EnvironmentDefinition">
        <Id>
            <TypeId>EnvironmentDefinition</TypeId>
            <SubtypeId>Default</SubtypeId>
        </Id>

        <EnvironmentTexture>Textures\BackgroundCube\Final\SkyBox.dds</EnvironmentTexture>
        <EnvironmentOrientation Yaw="60.3955536" Pitch="-61.1861954" Roll="90.90578" />

        <PlanetProperties>
            <AtmosphereIntensityMultiplier>17</AtmosphereIntensityMultiplier>
            <AtmosphereIntensityAmbientMultiplier>5</AtmosphereIntensityAmbientMultiplier><!-- 10 -->
            <CloudsIntensityMultiplier>13</CloudsIntensityMultiplier><!-- 17 -->
        </PlanetProperties>
        <FogProperties>
            <FogMultiplier>0</FogMultiplier>
            <FogDensity>0.003</FogDensity>
            <FogColor>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
            </FogColor>
        </FogProperties>

        <SunProperties>
            <SunIntensity>150</SunIntensity>
            <EnvironmentProbe>
                <TimeOut>0.3</TimeOut>
                <DrawDistance>130</DrawDistance>
                <AmbientScale>0.1</AmbientScale>
                <AmbientMinClamp>0.02</AmbientMinClamp>
                <AmbientMaxClamp>0.3</AmbientMaxClamp>
            </EnvironmentProbe>
            <EnvironmentLight>
                <SunColor>
                    <X>1</X>
                    <Y>0.9</Y>
                    <Z>0.8</Z>
                </SunColor>
    
                <SunDiffuseFactor>0.5</SunDiffuseFactor>
                <SunGlossFactor>1.0</SunGlossFactor>
                <SunSpecularFactor>0.150</SunSpecularFactor>
    
                <AmbientDiffuseFactor>1.0</AmbientDiffuseFactor>
                <AmbientSpecularFactor>2.2</AmbientSpecularFactor>
                <GlassAmbient>0</GlassAmbient>
                <AmbientForwardPass>0.0</AmbientForwardPass>
                <AmbientGlobalMinimum>0</AmbientGlobalMinimum>
                <AmbientGlobalDensity>0</AmbientGlobalDensity>
                <AmbientGlobalMultiplier>0</AmbientGlobalMultiplier>
    
                <SunDiscColor>
                  <X>1.0</X>
                  <Y>0.85</Y>
                  <Z>0.08</Z>
                  <W>1</W>
                </SunDiscColor>
                <SunDiscColor2>
                  <X>1.0</X>
                  <Y>0.92</Y>
                  <Z>0.10</Z>
                  <W>1</W>
                </SunDiscColor2>
                <SunDiscInnerDot>0.99993893436</SunDiscInnerDot>
                <SunDiscOuterDot>0.99992061094</SunDiscOuterDot>
    
                <AODirLight>1</AODirLight>
                <AOIndirectLight>1</AOIndirectLight>
                <AOPointLight>0.7</AOPointLight>
                <AOSpotLight>0.7</AOSpotLight>
    
                <SkyboxBrightness>0.4</SkyboxBrightness><!-- 1.0 -->
                <EnvSkyboxBrightness>1.5</EnvSkyboxBrightness><!-- 5.0 -->
                <ShadowFadeoutMultiplier>0.0</ShadowFadeoutMultiplier>
                <EnvShadowFadeoutMultiplier>0</EnvShadowFadeoutMultiplier>
                <EnvAtmosphereBrightness>1.0</EnvAtmosphereBrightness>
    
                <AmbientRadius>50.0</AmbientRadius>
                <AmbientLightsGatherRadius>15.0</AmbientLightsGatherRadius>
                <SunDiscIntensity>2.0</SunDiscIntensity>
            </EnvironmentLight>
            <TextureMultipliers>
                <GlossMultiplier>1.0</GlossMultiplier>
            </TextureMultipliers>
        </SunProperties>

        <ShadowSettings>
           <Data>
              <ShowShadowCascadeSplits>false</ShowShadowCascadeSplits>
              <UpdateCascadesEveryFrame>false</UpdateCascadesEveryFrame>
              <EnableShadowBlur>true</EnableShadowBlur>
              <ShadowCascadeMaxDistance>8000</ShadowCascadeMaxDistance>
              <ShadowCascadeMaxDistanceMultiplierMedium>2</ShadowCascadeMaxDistanceMultiplierMedium>
              <ShadowCascadeMaxDistanceMultiplierHigh>3.5</ShadowCascadeMaxDistanceMultiplierHigh>
              <ShadowCascadeMaxDistanceMultiplierExtreme>4.0</ShadowCascadeMaxDistanceMultiplierExtreme>
              <ShadowCascadeSpreadFactor>0</ShadowCascadeSpreadFactor>
              <ShadowCascadeZOffset>40000</ShadowCascadeZOffset>
              <LightDirectionChangeDelayMultiplier>18</LightDirectionChangeDelayMultiplier>
              <DisplayFrozenShadowCascade>false</DisplayFrozenShadowCascade>
              <ReflectorShadowDistanceLow>0.2</ReflectorShadowDistanceLow>
              <ReflectorShadowDistanceMedium>0.4</ReflectorShadowDistanceMedium>
              <ReflectorShadowDistanceHigh>1.0</ReflectorShadowDistanceHigh>
              <ReflectorShadowDistanceExtreme>1.0</ReflectorShadowDistanceExtreme>
              <LightDirectionDifferenceThreshold>0.0175</LightDirectionDifferenceThreshold>
              <ZBias>0.01</ZBias>
           </Data>
        </ShadowSettings>

    </Definition>
</Definitions>
